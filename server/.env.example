# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/payback_reminder?schema=public"

# --- Auth ---
# Set AUTH_PROVIDER to "local" (built-in JWT auth), "clerk", or "firebase"
AUTH_PROVIDER=local
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Clerk (only needed if AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Firebase Admin (only needed if AUTH_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email (choose one provider) ---
EMAIL_PROVIDER=resend # resend | nodemailer

RESEND_API_KEY=
EMAIL_FROM="PayBack Reminder <reminders@yourdomain.com>"

# Nodemailer / SMTP (used if EMAIL_PROVIDER=nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Reminder cron ---
# Cron expression checked every day to decide which borrowers get a reminder
REMINDER_CRON="0 9 * * *"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
